ENV=production
SECRET_KEY=poly-enspd-secret-key-2026-douala-rag-secure

# Base de données (PostgreSQL + pgvector pour Docker, ou sqlite:///./poly.db en local)
DATABASE_URL=postgresql://poly_user:poly_secure_password_2026@db:5432/poly_db

# Modèle de langage (mock ou anthropic)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
